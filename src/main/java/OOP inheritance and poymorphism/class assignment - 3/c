import java.time.*;
import java.util.*;

public class Week8Problem3 {
    static class Customer {
        String name;

        Customer(String name) {
            this.name = name;
        }
    }

    static abstract class Room {
        String name;

        Room(String name) {
            this.name = name;
        }

        abstract double getPrice();
    }

    static class StandardRoom extends Room {
        StandardRoom(String name) {
            super(name);
        }

        double getPrice() {
            return 150;
        }
    }

    static class DeluxeRoom extends Room {
        DeluxeRoom(String name) {
            super(name);
        }

        double getPrice() {
            return 200;
        }
    }

    static class Suite extends Room {
        Suite(String name) {
            super(name);
        }

        double getPrice() {
            return 300;
        }
    }

    static class Reservation {
        Room room;
        Customer customer;
        LocalDate start, end, deadline;
        boolean active = true;

        Reservation(Room room, Customer customer,
                    LocalDate start, LocalDate end, LocalDate deadline) {
            this.room = room;
            this.customer = customer;
            this.start = start;
            this.end = end;
            this.deadline = deadline;
        }

        double getTotal() {
            return room.getPrice() * (end.toEpochDay() - start.toEpochDay());
        }

        boolean overlaps(LocalDate s, LocalDate e) {
            return active && start.isBefore(e) && s.isBefore(end);
        }
    }

    static class BookingManager {
        List<Reservation> reservations = new ArrayList<>();

        void book(Room room, Customer customer,
                  LocalDate start, LocalDate end, LocalDate deadline) {
            for (Reservation r : reservations) {
                if (r.room == room && r.overlaps(start, end)) {
                    System.out.println("Booking failed: " + room.name
                            + " is not available.");
                    return;
                }
            }

            if (!start.isBefore(end)) {
                System.out.println("Invalid dates");
                return;
            }

            Reservation r = new Reservation(room, customer, start, end, deadline);
            reservations.add(r);

            System.out.println(room.name + " booked from " + start + " to " + end);
            System.out.printf("Total price: $%.2f%n", r.getTotal());
        }

        void cancel(Reservation r, LocalDate today) {
            if (!r.active) {
                System.out.println("Reservation already cancelled");
            } else if (!today.isBefore(r.deadline)) {
                System.out.println("Cancellation deadline has passed");
            } else {
                r.active = false;
                System.out.println("Reservation for " + r.room.name
                        + " cancelled successfully.");
            }
        }
    }

    public static void main(String[] args) {
        BookingManager manager = new BookingManager();
        Customer c = new Customer("John");

        Room deluxe = new DeluxeRoom("Deluxe Room 101");
        Room standard = new StandardRoom("Standard Room 205");

        LocalDate deadline = LocalDate.of(2024, 11, 25);

        manager.book(deluxe, c,
                LocalDate.of(2024, 12, 1),
                LocalDate.of(2024, 12, 5), deadline);

        manager.book(standard, c,
                LocalDate.of(2024, 12, 3),
                LocalDate.of(2024, 12, 7), deadline);

        manager.book(deluxe, c,
                LocalDate.of(2024, 12, 3),
                LocalDate.of(2024, 12, 7), deadline);

        manager.cancel(manager.reservations.get(0),
                LocalDate.of(2024, 11, 20));
    }
}