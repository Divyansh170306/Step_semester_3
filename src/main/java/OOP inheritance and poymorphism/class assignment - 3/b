import java.util.*;

public class Week8Problem2 {
    static abstract class Vehicle {
        String name;
        boolean available = true;

        Vehicle(String name) {
            this.name = name;
        }

        abstract double calculateCharge(int days);
    }

    static class StandardCar extends Vehicle {
        StandardCar(String name) {
            super(name);
        }

        double calculateCharge(int days) {
            return days * 50;
        }
    }

    static class LuxuryCar extends Vehicle {
        LuxuryCar(String name) {
            super(name);
        }

        double calculateCharge(int days) {
            return days * 100;
        }
    }

    static class SUV extends Vehicle {
        SUV(String name) {
            super(name);
        }

        double calculateCharge(int days) {
            return days * 80;
        }
    }

    static class Rental {
        Vehicle vehicle;
        int days;

        Rental(Vehicle vehicle, int days) {
            this.vehicle = vehicle;
            this.days = days;
        }

        double getTotal() {
            return vehicle.calculateCharge(days);
        }
    }

    static class RentalService {
        List<Rental> rentals = new ArrayList<>();

        void rent(Vehicle v, int days) {
            if (!v.available || days <= 0) {
                System.out.println("Vehicle unavailable");
                return;
            }

            v.available = false;
            Rental r = new Rental(v, days);
            rentals.add(r);

            System.out.println(v.name + " rented for " + days + " days.");
            System.out.printf("Total charge: $%.2f%n", r.getTotal());
        }

        void returnVehicle(Vehicle v) {
            if (v.available) {
                System.out.println("Vehicle is already available");
                return;
            }

            v.available = true;
            System.out.println(v.name + " returned. Now available.");
        }
    }

    public static void main(String[] args) {
        RentalService service = new RentalService();

        Vehicle v1 = new LuxuryCar("Luxury Car A");
        Vehicle v2 = new StandardCar("Standard Car B");

        service.rent(v1, 3);
        service.rent(v2, 5);
        service.returnVehicle(v1);
    }
}